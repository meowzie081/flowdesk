# Supabase (публичные значения, можно в браузер)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Для создания пользователей владельцем отдела (только сервер):
SUPABASE_SERVICE_ROLE_KEY=

# Только сервер. Никогда не добавляйте префикс NEXT_PUBLIC_
# AI_PROVIDER: gemini, groq или ollama (пишите без комментария в той же строке)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Необязательно: имя модели, если провайдер снял модель по умолчанию
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b   (запасной вариант: openai/gpt-oss-20b)

# Локальная модель (AI_PROVIDER=ollama): установите Ollama и выполните `ollama pull llama3.2`
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Google Analytics 4: Web stream Measurement ID. Пусто = аналитика отключена.
NEXT_PUBLIC_GA_ID=

# На VPS с Caddy задайте 127.0.0.1; для локальной сети оставьте 0.0.0.0
FLOWDESK_BIND_ADDRESS=0.0.0.0
