{
  "name": "flowdesk-desktop",
  "productName": "FlowDesk",
  "version": "0.2.0",
  "private": true,
  "description": "Десктопный клиент FlowDesk",
  "author": "FlowDesk",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test security.check.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:win:arm64": "electron-builder --win nsis --arm64 --publish never",
    "dist:win:cross": "node scripts/build-windows.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.flowdesk.desktop",
    "productName": "FlowDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "security.cjs",
      "app-config.json",
      "offline.html",
      "icon.png"
    ],
    "asar": true,
    "artifactName": "FlowDesk-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png",
      "artifactName": "FlowDesk-Setup-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "shortcutName": "FlowDesk",
      "uninstallDisplayName": "FlowDesk",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    }
  }
}
